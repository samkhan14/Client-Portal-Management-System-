generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  PLATFORM_ADMIN
  AGENCY_OWNER
  PROJECT_MANAGER
  TEAM_MEMBER
  CLIENT_ADMIN
  CLIENT_COLLABORATOR
  READ_ONLY
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  WAITING_ON_CLIENT
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  TEAM_MEMBER
  CLIENT_ADMIN
  CLIENT_COLLABORATOR
  READ_ONLY
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
}

enum ChangeRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum FileCategory {
  BRIEF
  DELIVERABLE
  REFERENCE
  CONTRACT
  OTHER
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  MEMBERSHIP_CHANGED
  TASK_CREATED
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  DEADLINE_CHANGED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  DELIVERABLE_CHANGES_REQUESTED
  COMMENT_ADDED
  FILE_UPLOADED
  INVOICE_CHANGED
  INVITATION_CREATED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships             Membership[]
  sessions                Session[]
  invitationsSent         Invitation[]           @relation("InvitationSender")
  projectMembers          ProjectMember[]
  projectsCreated         Project[]              @relation("ProjectCreator")
  tasksAssigned           Task[]                 @relation("TaskAssignee")
  tasksCreated            Task[]                 @relation("TaskCreator")
  taskStatusChanges       TaskStatusChange[]
  comments                Comment[]
  files                   FileAsset[]
  timeEntries             TimeEntry[]
  notifications           Notification[]
  activities              ActivityEvent[]
  versionsSubmitted       DeliverableVersion[]   @relation("VersionSubmitter")
  versionsReviewed        DeliverableVersion[]   @relation("VersionReviewer")
  deliverablesCreated     Deliverable[]          @relation("DeliverableCreator")
  onboardingCompletions   ClientOnboardingStep[]
  changeRequestsRequested ChangeRequest[]        @relation("ChangeRequester")
  changeRequestsDecided   ChangeRequest[]        @relation("ChangeDecider")
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  activeOrganizationId String?
  tokenHash            String    @unique
  csrfToken            String
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  userAgent            String?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Organization {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  emailNotificationsEnabled Boolean  @default(true)
  deadlineReminderDays      Int      @default(3)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  memberships     Membership[]
  clientCompanies ClientCompany[]
  projects        Project[]
  invitations     Invitation[]
  invoices        Invoice[]
  files           FileAsset[]
  notifications   Notification[]
  activities      ActivityEvent[]
  timeEntries     TimeEntry[]
  sessions        Session[]
}

model Membership {
  id              String    @id @default(cuid())
  userId          String
  organizationId  String
  role            OrgRole
  clientCompanyId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([clientCompanyId])
}

model ClientCompany {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  projects     Project[]
  invitations  Invitation[]
  steps        ClientOnboardingStep[]
  invoices     Invoice[]

  @@index([organizationId])
}

model ClientOnboardingStep {
  id              String    @id @default(cuid())
  clientCompanyId String
  title           String
  description     String?
  sortOrder       Int
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime  @default(now())

  clientCompany ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  completedBy   User?         @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([clientCompanyId, sortOrder])
}

model Invitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            OrgRole
  clientCompanyId String?
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany?      @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("InvitationSender", fields: [createdById], references: [id], onDelete: Restrict)
  projects      InvitationProject[]

  @@index([organizationId, email])
}

model InvitationProject {
  invitationId String
  projectId    String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([invitationId, projectId])
}

model Project {
  id                     String        @id @default(cuid())
  organizationId         String
  clientCompanyId        String
  name                   String
  reference              String
  description            String?
  scope                  String?
  internalNotes          String?
  status                 ProjectStatus @default(PLANNING)
  priority               Priority      @default(MEDIUM)
  startDate              DateTime?     @db.Date
  dueDate                DateTime?     @db.Date
  agreedFee              Decimal?      @db.Decimal(12, 2)
  agreedFeeClientVisible Boolean       @default(false)
  internalEstimate       Decimal?      @db.Decimal(12, 2)
  outstandingRequest     String?
  createdById            String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientCompany      ClientCompany       @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  milestones         Milestone[]
  tasks              Task[]
  comments           Comment[]
  files              FileAsset[]
  deliverables       Deliverable[]
  activities         ActivityEvent[]
  timeEntries        TimeEntry[]
  invoices           Invoice[]
  changeRequests     ChangeRequest[]
  invitationProjects InvitationProject[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, clientCompanyId])
  @@index([clientCompanyId])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime? @db.Date
  sortOrder   Int
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, dueDate])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  milestoneId   String?
  parentTaskId  String?
  title         String
  description   String?
  assigneeId    String?
  creatorId     String
  status        TaskStatus @default(TODO)
  priority      Priority   @default(MEDIUM)
  startDate     DateTime?  @db.Date
  dueDate       DateTime?  @db.Date
  estimateHours Decimal?   @db.Decimal(8, 2)
  clientVisible Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent        Task?              @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]             @relation("Subtasks")
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator       User               @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  statusChanges TaskStatusChange[]
  comments      Comment[]
  dependencies  TaskDependency[]   @relation("Dependent")
  blocking      TaskDependency[]   @relation("Blocker")
  timeEntries   TimeEntry[]
  files         FileAsset[]

  @@index([projectId, status])
  @@index([assigneeId, status, dueDate])
  @@index([projectId, clientVisible])
  @@index([milestoneId])
  @@index([parentTaskId])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  blockedByTaskId String

  task      Task @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("Blocker", fields: [blockedByTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, blockedByTaskId])
  @@index([blockedByTaskId])
}

model TaskStatusChange {
  id          String      @id @default(cuid())
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  createdAt   DateTime    @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model Comment {
  id            String   @id @default(cuid())
  projectId     String
  taskId        String?
  deliverableId String?
  authorId      String
  body          String
  clientVisible Boolean  @default(false)
  createdAt     DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  files       FileAsset[]

  @@index([projectId, clientVisible, createdAt])
  @@index([taskId])
}

model ActivityEvent {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  type           ActivityType
  clientVisible  Boolean      @default(false)
  summary        String
  entityType     String
  entityId       String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, clientVisible, createdAt])
  @@index([organizationId, createdAt])
}

model FileAsset {
  id                   String       @id @default(cuid())
  organizationId       String
  projectId            String
  uploadedById         String
  category             FileCategory @default(OTHER)
  originalName         String
  mimeType             String
  sizeBytes            Int
  storageKey           String       @unique
  clientVisible        Boolean      @default(false)
  deletedAt            DateTime?
  deliverableVersionId String?
  commentId            String?
  taskId               String?
  createdAt            DateTime     @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  deliverableVersion DeliverableVersion? @relation(fields: [deliverableVersionId], references: [id], onDelete: SetNull)
  comment            Comment?            @relation(fields: [commentId], references: [id], onDelete: SetNull)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, clientVisible])
  @@index([organizationId, deletedAt])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("DeliverableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  DeliverableVersion[]
  comments  Comment[]

  @@index([projectId])
}

model DeliverableVersion {
  id            String            @id @default(cuid())
  deliverableId String
  versionNumber Int
  notes         String?
  externalLink  String?
  status        DeliverableStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?
  reviewerId    String?
  decidedAt     DateTime?
  feedback      String?
  createdAt     DateTime          @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  submittedBy User?       @relation("VersionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewer    User?       @relation("VersionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  files       FileAsset[]

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId, status])
  @@index([status])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  type           String
  title          String
  body           String
  linkPath       String?
  dedupeKey      String              @unique
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([status, channel])
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String
  userId         String
  minutes        Int
  billable       Boolean  @default(true)
  workDate       DateTime @db.Date
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate])
  @@index([userId, workDate])
}

model ChangeRequest {
  id            String              @id @default(cuid())
  projectId     String
  title         String
  description   String?
  amount        Decimal             @db.Decimal(12, 2)
  status        ChangeRequestStatus @default(REQUESTED)
  clientVisible Boolean             @default(false)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("ChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, clientVisible])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  projectId       String
  clientCompanyId String
  number          String
  amount          Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  issuedDate      DateTime      @db.Date
  clientVisible   Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([projectId, clientVisible])
  @@index([organizationId, status])
}
