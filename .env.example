# Local PostgreSQL. Copy to .env and set a real password. Never commit .env.
DATABASE_URL="postgresql://portal:change-me@127.0.0.1:5432/portal?schema=public"
# Vitest overrides this to the portal_test database. Do not point tests at production.
TEST_DATABASE_URL="postgresql://portal:change-me@127.0.0.1:5432/portal_test?schema=public"
